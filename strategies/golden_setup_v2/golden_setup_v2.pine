// ═══════════════════════════════════════════════════════════════════════════
// PROJECT ZERO — STRATEGY S3
// GOLDEN SETUP V2 — Faithful to Subasish Pani (Power of Stocks)
// ═══════════════════════════════════════════════════════════════════════════
// SOURCE: Subasish Pani — Token IQ / Sark Exchange session transcript
//
// HIS EXACT LOGIC:
//   1. Note session opening price
//   2. Find nearest 500 round level above AND below opening
//   3. Open > lower round → LONG at lower level
//      Open < upper round → SHORT at upper level
//   4. Touch that level → enter with fixed stop
//   5. Fixed stop (200-250 pts BTC), fixed target (700-1000+)
//   6. Up to 4 attempts per session at same level
//   7. One 1:4-1:5 winner covers multiple losses
//
// NOTHING ADDED — no daily/weekly filters, no S/R detection, pure logic
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
strategy("PZ-S3-GoldenV2", overlay=true, pyramiding=0, calc_on_order_fills=false, calc_on_every_tick=false, process_orders_on_close=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.05)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — all on single lines (Pine v6 multi-line input quirks avoided)
// ═══════════════════════════════════════════════════════════════════════════

i_mode         = input.string("BACKTEST", "Mode", options=["BACKTEST", "LIVE_ALERTS"])
i_round_unit   = input.float(500.0, "Round Level Unit (BTC intraday=500, positional=1000, Gold=50)", minval=1, step=1)
i_stop_pts     = input.float(200.0, "Fixed Stop Points (BTC=200-250)", minval=10, maxval=1000, step=10)
i_target_pts   = input.float(800.0, "Minimum Target Points (BTC=700-1000+)", minval=100, maxval=5000, step=50)
i_max_attempts = input.int(4, "Max Attempts Per Session (Subasish says: 4)", minval=1, maxval=10)
i_buffer_pts   = input.float(50.0, "Entry Buffer Beyond Round Level (pts, 0=strict touch)", minval=0, maxval=300, step=10)
i_longs        = input.bool(true,  "Allow Longs")
i_shorts       = input.bool(true,  "Allow Shorts")
i_use_session  = input.bool(true,  "Enable Session Window")
i_sess_start   = input.int(13, "Session Start Hour UTC (13=US Open=6:30PM IST)", minval=0, maxval=23)
i_sess_end     = input.int(21, "Session End Hour UTC", minval=0, maxval=23)
i_max_bars     = input.int(48, "Max Bars Per Trade (time stop)", minval=4, maxval=200)
i_secret       = input.string("CHANGE_ME", "Webhook Secret")
i_strategy_id  = input.string("S3_GOLDEN_V2", "Strategy ID")
i_asset        = input.string("BTC", "Asset Label")

// ═══════════════════════════════════════════════════════════════════════════
// ROUND LEVEL MATH
// ═══════════════════════════════════════════════════════════════════════════

_roundAbove(price) => math.ceil(price  / i_round_unit) * i_round_unit
_roundBelow(price) => math.floor(price / i_round_unit) * i_round_unit

// ═══════════════════════════════════════════════════════════════════════════
// SESSION HELPERS
// ═══════════════════════════════════════════════════════════════════════════

_utcH() => hour(time, "UTC")
_utcM() => minute(time, "UTC")

_inSession() =>
    if not i_use_session
        true
    else
        h = _utcH()
        i_sess_start <= i_sess_end ? (h >= i_sess_start and h < i_sess_end) : (h >= i_sess_start or h < i_sess_end)

_isSessionOpen() =>
    _utcH() == i_sess_start and _utcM() < 15

// ═══════════════════════════════════════════════════════════════════════════
// SESSION OPENING PRICE — captured once at session start
// ═══════════════════════════════════════════════════════════════════════════

var float sessOpen       = na
var float roundAboveOpen = na
var float roundBelowOpen = na
var int   sessAttempts   = 0

if _isSessionOpen() and barstate.isconfirmed
    sessOpen       := open
    roundAboveOpen := _roundAbove(open)
    roundBelowOpen := _roundBelow(open)
    sessAttempts   := 0

// ═══════════════════════════════════════════════════════════════════════════
// DIRECTION FROM OPENING PRICE
// His logic: open > lower round → LONG valid at lower round
//            open < upper round → SHORT valid at upper round
// ═══════════════════════════════════════════════════════════════════════════

longValid  = i_longs  and not na(sessOpen) and sessOpen > roundBelowOpen
shortValid = i_shorts and not na(sessOpen) and sessOpen < roundAboveOpen

longEntryLevel  = roundBelowOpen + i_buffer_pts
shortEntryLevel = roundAboveOpen - i_buffer_pts

// Stop and target (fixed points — as he teaches)
longStop    = longEntryLevel  - i_stop_pts
longTarget  = longEntryLevel  + i_target_pts
shortStop   = shortEntryLevel + i_stop_pts
shortTarget = shortEntryLevel - i_target_pts

// Minimum R:R safety check
rr = i_target_pts / math.max(i_stop_pts, 1.0)

// ═══════════════════════════════════════════════════════════════════════════
// SIGNAL DETECTION
// ═══════════════════════════════════════════════════════════════════════════

longSignal = longValid
longSignal := longSignal and _inSession()
longSignal := longSignal and low <= longEntryLevel
longSignal := longSignal and strategy.position_size == 0
longSignal := longSignal and sessAttempts < i_max_attempts
longSignal := longSignal and rr >= 3.0
longSignal := longSignal and barstate.isconfirmed

shortSignal = shortValid
shortSignal := shortSignal and _inSession()
shortSignal := shortSignal and high >= shortEntryLevel
shortSignal := shortSignal and strategy.position_size == 0
shortSignal := shortSignal and sessAttempts < i_max_attempts
shortSignal := shortSignal and rr >= 3.0
shortSignal := shortSignal and barstate.isconfirmed

// ═══════════════════════════════════════════════════════════════════════════
// BACKTEST EXECUTION
// ═══════════════════════════════════════════════════════════════════════════

if i_mode == "BACKTEST"
    if longSignal
        sessAttempts += 1
        strategy.entry("Long", strategy.long, comment="GoldenLong")
        strategy.exit("Long_X", "Long", stop=longStop, limit=longTarget, comment_loss="SL", comment_profit="Target")

    if shortSignal
        sessAttempts += 1
        strategy.entry("Short", strategy.short, comment="GoldenShort")
        strategy.exit("Short_X", "Short", stop=shortStop, limit=shortTarget, comment_loss="SL", comment_profit="Target")

    if strategy.opentrades > 0
        barsHeld = bar_index - strategy.opentrades.entry_bar_index(0)
        if barsHeld >= i_max_bars
            strategy.close_all(comment="TimeStop")

    if not _inSession() and strategy.position_size != 0
        strategy.close_all(comment="SessionEnd")

// ═══════════════════════════════════════════════════════════════════════════
// LIVE ALERTS
// ═══════════════════════════════════════════════════════════════════════════

if i_mode == "LIVE_ALERTS" and barstate.isconfirmed
    if longSignal
        msg = '{"secret":"' + i_secret + '","strategy_id":"' + i_strategy_id + '","signal_type":"GOLDEN_SETUP_V2","signal":"BUY","symbol":"' + syminfo.ticker + '","asset":"' + i_asset + '","entry":' + str.tostring(longEntryLevel, "#.##") + ',"stop":' + str.tostring(longStop, "#.##") + ',"target":' + str.tostring(longTarget, "#.##") + ',"stop_pts":' + str.tostring(i_stop_pts, "#") + ',"target_pts":' + str.tostring(i_target_pts, "#") + ',"rr":' + str.tostring(rr, "#.##") + ',"session_open":' + str.tostring(sessOpen, "#.##") + ',"round_below":' + str.tostring(roundBelowOpen, "#.##") + ',"attempt":' + str.tostring(sessAttempts, "#") + '}'
        alert(msg, alert.freq_once_per_bar_close)

    if shortSignal
        msg = '{"secret":"' + i_secret + '","strategy_id":"' + i_strategy_id + '","signal_type":"GOLDEN_SETUP_V2","signal":"SELL","symbol":"' + syminfo.ticker + '","asset":"' + i_asset + '","entry":' + str.tostring(shortEntryLevel, "#.##") + ',"stop":' + str.tostring(shortStop, "#.##") + ',"target":' + str.tostring(shortTarget, "#.##") + ',"stop_pts":' + str.tostring(i_stop_pts, "#") + ',"target_pts":' + str.tostring(i_target_pts, "#") + ',"rr":' + str.tostring(rr, "#.##") + ',"session_open":' + str.tostring(sessOpen, "#.##") + ',"round_above":' + str.tostring(roundAboveOpen, "#.##") + ',"attempt":' + str.tostring(sessAttempts, "#") + '}'
        alert(msg, alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════

plot(roundAboveOpen,  "Round Above", color.new(color.red,   30), 2, plot.style_linebr)
plot(roundBelowOpen,  "Round Below", color.new(color.green, 30), 2, plot.style_linebr)
plot(longEntryLevel,  "Long Zone",   color.new(color.lime,  20), 1, plot.style_circles)
plot(shortEntryLevel, "Short Zone",  color.new(color.red,   20), 1, plot.style_circles)
plot(sessOpen,        "Sess Open",   color.new(color.yellow,40), 1, plot.style_linebr)
plot(strategy.position_size > 0 ? longStop    : na, "L Stop",   color.red,   1, plot.style_linebr)
plot(strategy.position_size > 0 ? longTarget  : na, "L Target", color.green, 1, plot.style_linebr)
plot(strategy.position_size < 0 ? shortStop   : na, "S Stop",   color.red,   1, plot.style_linebr)
plot(strategy.position_size < 0 ? shortTarget : na, "S Target", color.green, 1, plot.style_linebr)
plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal, text="🟢 GOLDEN")
plotshape(shortSignal, "Short", shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.normal, text="🔴 GOLDEN")

// ═══════════════════════════════════════════════════════════════════════════
// STATUS TABLE
// ═══════════════════════════════════════════════════════════════════════════

var table T = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 75), border_width=1)

if barstate.islast
    table.cell(T, 0, 0, "PZ-S3 GoldenV2", text_color=color.yellow, bgcolor=color.new(color.purple, 40), text_size=size.small)
    table.cell(T, 1, 0, i_mode, text_color=color.yellow, bgcolor=color.new(color.purple, 40), text_size=size.small)
    table.cell(T, 0, 1, "Sess Open",   text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 1, na(sessOpen) ? "—" : str.tostring(sessOpen, "#.##"), text_color=color.yellow, text_size=size.tiny)
    table.cell(T, 0, 2, "Round ▲",    text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 2, na(roundAboveOpen) ? "—" : str.tostring(roundAboveOpen, "#.##"), text_color=color.red, text_size=size.tiny)
    table.cell(T, 0, 3, "Round ▼",    text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 3, na(roundBelowOpen) ? "—" : str.tostring(roundBelowOpen, "#.##"), text_color=color.lime, text_size=size.tiny)
    table.cell(T, 0, 4, "Long Level",  text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 4, longValid ? str.tostring(longEntryLevel, "#.##") : "N/A", text_color=longValid ? color.lime : color.gray, text_size=size.tiny)
    table.cell(T, 0, 5, "Short Level", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 5, shortValid ? str.tostring(shortEntryLevel, "#.##") : "N/A", text_color=shortValid ? color.red : color.gray, text_size=size.tiny)
    table.cell(T, 0, 6, "Attempts",   text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 6, str.tostring(sessAttempts) + "/" + str.tostring(i_max_attempts), text_color=sessAttempts >= i_max_attempts ? color.red : color.white, text_size=size.tiny)
    table.cell(T, 0, 7, "SL/TGT pts", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 7, str.tostring(i_stop_pts, "#") + " / " + str.tostring(i_target_pts, "#") + " (1:" + str.tostring(rr, "#.#") + ")", text_color=rr >= 3.0 ? color.lime : color.red, text_size=size.tiny)
