# ============================================================
# PROJECTZERO — Environment Variables
# Add these in Vercel → Project Settings → Environment Variables
# ============================================================

# Supabase (get from supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Dashboard password (what you type to log into Projectzero)
DASHBOARD_PASSWORD=Pz@2026!

# JWT secret (generate any random string, keep secret)
JWT_SECRET=projectzero-super-secret-jwt-key-change-this

# Zerodha (optional - for future Kite Connect API upgrade)
ZERODHA_CLIENT_ID=FHP228
